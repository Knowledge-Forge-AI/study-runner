{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "rootDir": "runtime/source",
    "outDir": ".build",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["runtime/source/*.ts"]
}
